<odoo>

    <record id="sale_order_view_form_inherit_contabo" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.contabo</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="contabo"/>
                <field name="server_text"/>
                <field name="another_field"/>
                <field name="belal"/>
            </xpath>

        </field>
    </record>

</odoo>